{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cờ Chill: Chạy web local",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "8769",
        "--bind",
        "127.0.0.1",
        "--directory",
        "online-preview"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Cờ Chill: Kiểm tra toàn bộ",
      "type": "process",
      "command": "python",
      "args": [
        "tools/check_all.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
