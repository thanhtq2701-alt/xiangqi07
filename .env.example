# Documentation template only: the application does NOT automatically load .env.
# Set environment variables in PowerShell or in the hosting provider dashboard.
# Do not commit real secrets or a populated .env file.

# Local default; use an absolute durable-volume path when deployed.
CO_CHILL_DB_PATH=var/co_chill_accounts.sqlite3

# Empty is loopback-only. Production requires the exact HTTPS origin, no path
# or trailing slash. Choose one canonical domain, e.g. https://your-app.onrender.com.
CO_CHILL_PUBLIC_ORIGIN=

# Required to create/login as owner admin. Generate privately with:
# python co_chill_server.py generate-admin-totp
# Enrol the same Base32 key in an authenticator (TOTP, SHA-1, 6 digits, 30 seconds).
CO_CHILL_ADMIN_TOTP_SECRET=

# Optional engine paths. No engine executable or NNUE is bundled.
# Do not point a Linux host at a Windows .exe. Check binary and weight rights first.
PIKAFISH_PATH=
PIKAFISH_NNUE_PATH=
PIKAFISH_QUICK_MS=600
PIKAFISH_DEEP_MS=2000
PIKAFISH_THREADS=1
PIKAFISH_HASH_MB=32
