# Copy to /etc/cochill.env and set owner/permissions outside the repository.
# Keep secrets only in the private environment file, never in Git.

# Exact public origin; local-only mode leaves this empty.
CO_CHILL_PUBLIC_ORIGIN=

# Durable SQLite database location.
CO_CHILL_DB_PATH=

# Required TOTP secret for the owner admin. Keep private.
CO_CHILL_ADMIN_TOTP_SECRET=

# Absolute executable and NNUE paths for the optional local engine.
PIKAFISH_PATH=
PIKAFISH_NNUE_PATH=
PIKAFISH_QUICK_MS=
PIKAFISH_DEEP_MS=
PIKAFISH_THREADS=
PIKAFISH_HASH_MB=

# Trust only the local Nginx proxy; do not add public/client addresses.
CO_CHILL_TRUSTED_PROXIES=127.0.0.1
