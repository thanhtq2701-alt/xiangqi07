# Environment template for Cờ Chill. The application does NOT load .env files.
# Production: copy to /etc/cochill.env and set owner/permissions outside the
# repository (see deploy/DEPLOY_GCP_VI.md). Local: set variables in the shell.
# Keep secrets only in the private environment file, never in Git.

# Exact public origin with no path or trailing slash, e.g. https://cochill.vn.
# Leave empty for local loopback-only use.
CO_CHILL_PUBLIC_ORIGIN=

# Durable SQLite database location. Local default when empty:
# var/co_chill_accounts.sqlite3
CO_CHILL_DB_PATH=

# Required to create/log in as owner admin. Generate privately with:
#   python co_chill_server.py generate-admin-totp
# Enrol the same Base32 key in an authenticator (TOTP, SHA-1, 6 digits, 30 s).
CO_CHILL_ADMIN_TOTP_SECRET=

# Optional engine. No engine executable or NNUE is bundled; use absolute paths,
# never a Windows .exe on Linux, and check binary and weight rights first.
# Empty timing values use the defaults 600 / 2000 ms, 1 thread, 32 MB hash.
PIKAFISH_PATH=
PIKAFISH_NNUE_PATH=
PIKAFISH_QUICK_MS=
PIKAFISH_DEEP_MS=
PIKAFISH_THREADS=
PIKAFISH_HASH_MB=

# Trust X-Real-IP only from the local Nginx proxy; do not add public/client
# addresses. Leave empty for local-only use.
CO_CHILL_TRUSTED_PROXIES=127.0.0.1
